<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build target selector (defaults to jf12 below). The same source produces
         two artifacts, one per runtime, never one DLL for both:
           JellyfinTarget=jf12  -> Jellyfin 12, .NET 10
           JellyfinTarget=jf10  -> Jellyfin 10.11, .NET 9
         Script injection (ScriptInjectionStartupFilter) uses only standard
         ASP.NET, so it works unmodified on both runtimes. -->
    <JellyfinTarget Condition="'$(JellyfinTarget)' == ''">jf12</JellyfinTarget>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <RootNamespace>Jellyfin.Plugin.JavaScriptInjector</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.JavaScriptInjector</AssemblyName>
  </PropertyGroup>

  <!-- Jellyfin 12 / .NET 10. The Jellyfin.Controller/Model 12.0.0-rc1 NuGet packages
       bring the rest transitively. Bump to 12.0.0 once it ships. -->
  <PropertyGroup Condition="'$(JellyfinTarget)' == 'jf12'">
    <TargetFramework>net10.0</TargetFramework>
    <JellyfinVersion>12.0.0-rc5</JellyfinVersion>
  </PropertyGroup>

  <!-- Jellyfin 10.11 / .NET 9. Pinned to 10.11.0 (as upstream does) so the artifact
       loads across the whole 10.11.x line: a newer host satisfies the lower ref. -->
  <PropertyGroup Condition="'$(JellyfinTarget)' == 'jf10'">
    <TargetFramework>net9.0</TargetFramework>
    <JellyfinVersion>10.11.0</JellyfinVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)"/>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)"/>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <!-- Vendored CodeMirror 5 (config-page code editor). Served locally via
         JavaScriptInjectorController so the config page doesn't depend on a CDN. -->
    <None Remove="Configuration\vendor\codemirror\**" />
    <EmbeddedResource Include="Configuration\vendor\codemirror\**" />
  </ItemGroup>

</Project>
